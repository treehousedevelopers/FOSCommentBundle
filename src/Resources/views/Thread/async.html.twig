<div id="fos_comment_thread"></div>

<script>
    // Configure FOSCommentBundle
    window.FosComment = window.FosComment || {};
    window.FosComment.config = {
        threadId: '{{ id }}',
        view: '{{ view|default('tree') }}',
        apiBaseUrl: '{{ path('fos_comment_get_threads') }}'
    };

    // Snippet for asynchronously loading the comments
    (function() {
        const fos_comment_script = document.createElement('script');
        fos_comment_script.async = true;
        fos_comment_script.src = '{{ asset('bundles/foscomment/js/comments.js') }}';

        (document.getElementsByTagName('head')[0] || document.getElementsByTagName('body')[0]).appendChild(fos_comment_script);
    })();
</script>
